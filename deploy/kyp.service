[Unit]
Description=KYP ingredient API
After=network-online.target

[Service]
User=kyp
WorkingDirectory=/opt/kyp/backend
EnvironmentFile=/etc/kyp/environment
ExecStart=/opt/kyp/.venv/bin/python -m uvicorn kyp.api:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
